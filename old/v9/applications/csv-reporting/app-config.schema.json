{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"CSV Reporting AppConfig",
  "type":"object",
  "required":["remoteUrl","title","heading"],
  "properties":{
    "remoteUrl":{"type":"string","format":"uri","title":"Remote-CSV-URL"},
    "title":{"type":"string","title":"Seitentitel"},
    "heading":{"type":"string","title":"Überschrift"},
    "editorTitle":{"type":"string","title":"Editor-Bezeichnung","default":"Regeln"},
    "delimiter":{"type":"string","enum":[",",";","\\t"],"default":","},
    "refreshSeconds":{"type":"integer","minimum":0,"maximum":86400,"default":0},
    "timeoutSeconds":{"type":"integer","minimum":2,"maximum":60,"default":20},
    "hasHeader":{"type":"boolean","default":true},
    "showColumns":{"type":"array","items":{"type":"string"},"default":[]},
    "columnRenames":{"type":"object","additionalProperties":{"type":"string"},"default":{}},
    "columnLinks":{"type":"object","additionalProperties":{"type":"string"},"default":{}},
    "filters":{"type":"array","items":{"type":"object"},"default":[]},
    "rules":{"type":"array","items":{"type":"object"},"default":[]}
  },
  "additionalProperties":false
}
