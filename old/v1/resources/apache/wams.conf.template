<VirtualHost *:__PORT__>
    ServerName __SERVER_NAME__
    DocumentRoot __INSTALL_ROOT__/public
    <Directory __INSTALL_ROOT__/public>
        AllowOverride All
        Require all granted
        Options -Indexes
    </Directory>
    <Directory __INSTALL_ROOT__/state>
        Require all denied
    </Directory>
    ErrorLog ${APACHE_LOG_DIR}/wams-error.log
    CustomLog ${APACHE_LOG_DIR}/wams-access.log combined
</VirtualHost>
