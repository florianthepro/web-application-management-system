Listen __PORT__
<VirtualHost *:__PORT__>
 DocumentRoot __ROOT__/public
 SSLEngine on
 SSLCertificateFile __ROOT__/state/tls/server.crt
 SSLCertificateKeyFile __ROOT__/state/tls/server.key
 <Directory __ROOT__/public>
  Options -Indexes
  Require all granted
  DirectoryIndex index.php
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [QSA,L]
 </Directory>
</VirtualHost>
